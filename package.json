{
  "name": "kiara-medicals",
  "version": "1.0.0",
  "private": true,
  "description": "Kiara Medicals — Multi-Branch Medical Store Management System",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "backup": "npm run backup --workspace=server",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prisma": "^5.18.0"
  },
  "author": "Kiara Medicals Tech Team",
  "license": "UNLICENSED",
  "allowScripts": {
    "canvas@3.2.3": true
  },
  "dependencies": {
    "canvas": "^3.2.3"
  }
}
