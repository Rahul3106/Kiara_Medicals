// Prisma schema for Kiara Medicals — Multi-Branch Medical Store Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. BRANCH & USER MANAGEMENT
// ==========================================

model Branch {
  id            String    @id @default(uuid())
  name          String    // e.g. Kiara Medicals - Branch 1
  code          String    @unique // e.g. "BR-A", "BR-B"
  address       String
  city          String
  state         String    @default("Maharashtra")
  pincode       String
  phone         String
  email         String?
  gstNumber     String    // 15-character GSTIN
  drugLicenseNo String    // e.g. Form 20B / 21B numbers
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships
  users         User[]
  batches       Batch[]
  suppliers     Supplier[]
  customers     Customer[]
  purchases     Purchase[]
  sales         Sale[]
  auditLogs     AuditLog[]

  @@index([code])
}

model User {
  id           String    @id @default(uuid())
  branchId     String?   // NULL for SUPER_ADMIN
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         String    @default("STAFF") // SUPER_ADMIN, BRANCH_MANAGER, STAFF
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relationships
  branch       Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  purchases    Purchase[] @relation("PurchaseCreatedBy")
  sales        Sale[]     @relation("BilledByUser")
  auditLogs    AuditLog[]

  @@index([branchId])
  @@index([role])
}

// ==========================================
// 2. MEDICINE MASTER & BATCH INVENTORY
// ==========================================

model Medicine {
  id                   String         @id @default(uuid())
  name                 String         // Brand name (e.g., Dolo 650)
  genericName          String?        // Generic salt (e.g., Paracetamol)
  composition          String?        // e.g. Paracetamol 650mg
  manufacturer         String?        // e.g. Micro Labs
  category             String?        // Analgesic, Antibiotic, etc.
  hsnCode              String         @default("3004")
  unit                 String         @default("STRIP") // TABLET, STRIP, BOTTLE, etc.
  gstRate              Decimal        @default(12.0)
  minReorderLevel      Int            @default(10)
  prescriptionRequired Boolean        @default(false)
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  // Relationships
  batches              Batch[]
  purchaseItems        PurchaseItem[]
  saleItems            SaleItem[]

  @@index([name])
  @@index([genericName])
  @@index([hsnCode])
}

model Batch {
  id            String         @id @default(uuid())
  medicineId    String
  branchId      String
  batchNumber   String
  expiryDate    DateTime
  mfgDate       DateTime?
  purchasePrice Decimal
  mrp           Decimal
  sellingPrice  Decimal
  quantity      Int            @default(0)
  rackLocation  String?        // e.g., "A-12", "Cold-Storage-1"
  isArchived    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relationships
  medicine      Medicine       @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]

  @@unique([branchId, medicineId, batchNumber])
  @@index([branchId, expiryDate])
  @@index([branchId, quantity])
}

// ==========================================
// 3. SUPPLIER & PURCHASE MANAGEMENT
// ==========================================

model Supplier {
  id            String     @id @default(uuid())
  branchId      String?    // NULL if central supplier, otherwise branch-specific
  name          String
  agencyName    String?
  contactPerson String?
  phone         String
  email         String?
  address       String?
  gstNumber     String?
  drugLicenseNo String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relationships
  branch        Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  purchases     Purchase[]

  @@index([branchId])
  @@index([name])
}

model Purchase {
  id             String        @id @default(uuid())
  branchId       String
  supplierId     String
  createdById    String
  invoiceNumber  String        // Supplier's Bill Number
  purchaseDate   DateTime
  subTotal       Decimal
  taxAmount      Decimal
  discountAmount Decimal       @default(0.0)
  netAmount      Decimal
  paymentStatus  String        @default("PENDING") // PAID, PARTIAL, PENDING
  invoiceScanUrl String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relationships
  branch         Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier       Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy      User          @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  items          PurchaseItem[]

  @@unique([branchId, supplierId, invoiceNumber])
  @@index([branchId, purchaseDate])
}

model PurchaseItem {
  id            String   @id @default(uuid())
  purchaseId    String
  medicineId    String
  batchId       String
  batchNumber   String
  expiryDate    DateTime
  quantity      Int
  freeQuantity  Int      @default(0)
  purchasePrice Decimal
  mrp           Decimal
  taxRate       Decimal
  taxAmount     Decimal
  totalAmount   Decimal

  // Relationships
  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  medicine      Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  batch         Batch    @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
}

// ==========================================
// 4. CUSTOMER, SALES & GST INVOICING
// ==========================================

model Customer {
  id           String   @id @default(uuid())
  branchId     String
  name         String
  phone        String
  email        String?
  address      String?
  doctorName   String?
  doctorRegNo  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sales        Sale[]

  @@index([branchId, phone])
}

model Sale {
  id              String      @id @default(uuid())
  branchId        String
  customerId      String?
  billedById      String
  billNumber      String      // Formatted: KM-BR-A-2627-00001
  saleDate        DateTime    @default(now())
  subTotal        Decimal
  cgstAmount      Decimal     @default(0.0)
  sgstAmount      Decimal     @default(0.0)
  igstAmount      Decimal     @default(0.0)
  totalTaxAmount  Decimal
  discountAmount  Decimal     @default(0.0)
  roundOff        Decimal     @default(0.0)
  grandTotal      Decimal
  paymentMode     String      @default("CASH") // CASH, UPI, CARD, CREDIT, SPLIT
  status          String      @default("COMPLETED") // COMPLETED, REFUNDED, CANCELLED
  prescriptionUrl String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relationships
  branch          Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  billedBy        User        @relation("BilledByUser", fields: [billedById], references: [id])
  items           SaleItem[]

  @@unique([branchId, billNumber])
  @@index([branchId, saleDate])
  @@index([branchId, status])
}

model SaleItem {
  id              String   @id @default(uuid())
  saleId          String
  medicineId      String
  batchId         String
  batchNumber     String
  expiryDate      DateTime
  quantity        Int
  unitPrice       Decimal
  mrp             Decimal
  discountPercent Decimal  @default(0.0)
  discountAmount  Decimal  @default(0.0)
  taxRate         Decimal
  cgstAmount      Decimal  @default(0.0)
  sgstAmount      Decimal  @default(0.0)
  igstAmount      Decimal  @default(0.0)
  netAmount       Decimal

  // Relationships
  sale            Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicine        Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)
  batch           Batch    @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([saleId])
}

// ==========================================
// 5. AUDIT LOGGING & COMPLIANCE
// ==========================================

model AuditLog {
  id         String   @id @default(uuid())
  branchId   String?
  userId     String?
  action     String   // e.g. "STOCK_OVERRIDE", "INVOICE_CANCELLED", "PRICE_UPDATE"
  entityType String   // e.g. "Batch", "Sale", "User"
  entityId   String
  oldValues  String?  // JSON stringified in SQLite
  newValues  String?  // JSON stringified in SQLite
  ipAddress  String?
  createdAt  DateTime @default(now())

  // Relationships
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([branchId, createdAt])
  @@index([action])
}
