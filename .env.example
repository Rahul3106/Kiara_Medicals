# ==========================================
# KIARA MEDICALS — PRODUCTION CONFIGURATION
# ==========================================

# Server Environment
PORT=5000
NODE_ENV=production

# ------------------------------------------
# 1. Database Connection (PostgreSQL)
# ------------------------------------------
# Standard PostgreSQL URI format (Supported: Supabase, Neon, AWS RDS, GCP Cloud SQL, or Local Postgres)
# Examples:
#   Local:    postgresql://postgres:password@localhost:5432/kiara_medicals?schema=public
#   Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#   Neon:     postgresql://user:password@ep-cool-flower-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/kiara_medicals?schema=public"

# ------------------------------------------
# 2. Cryptographic JWT Secrets (256-bit Keys)
# ------------------------------------------
# Generated using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="a6aeb24337824e922c4c74fae57ae5aab3f3e0284c3f0b2666bacffb0c4e50e9"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="f033a5cd2d35d6f6d8ddb0844c72bb3071115041baf2d7f67a46b544c8cbecd4"
JWT_REFRESH_EXPIRES_IN="7d"

# ------------------------------------------
# 3. Security & CORS Configuration
# ------------------------------------------
# Comma-separated list of allowed origins. In production, lock this strictly to your front-end domain(s).
CORS_ORIGIN="https://app.kiaramedicals.com,https://admin.kiaramedicals.com,http://localhost:5173"
# Optional cookie domain for subdomains (e.g. .kiaramedicals.com)
COOKIE_DOMAIN=""

# ------------------------------------------
# 4. Rate Limiting (Brute-force protection)
# ------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_LOGIN_ATTEMPTS=10

# ------------------------------------------
# 5. Database Backup Configuration
# ------------------------------------------
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=30

# ------------------------------------------
# 6. Cloudflare R2 / S3 Object Storage (Phase 2)
# ------------------------------------------
# Set STORAGE_DRIVER="r2" for Cloudflare R2 or "local" for disk fallback
STORAGE_DRIVER="r2"
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="kiara-medicals-storage"
R2_PUBLIC_DOMAIN="https://cdn.kiaramedicals.com"
LOCAL_UPLOAD_DIR="./uploads"

# ------------------------------------------
# 7. Sentry Error Monitoring (Phase 2)
# ------------------------------------------
# Backend Sentry DSN (Node.js)
SENTRY_DSN=""
# Frontend Sentry DSN (React / Vite)
VITE_SENTRY_DSN=""
